#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} pc;

layout(set = 0, binding = 0) readonly buffer BufA { float A[]; };
layout(set = 0, binding = 1) readonly buffer BufB { float B[]; };
layout(set = 0, binding = 2) writeonly buffer BufC { float C[]; };

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint lx  = gl_LocalInvocationID.x;
    uint ly  = gl_LocalInvocationID.y;

    float acc = 0.0;
    uint num_tiles = (pc.K + 15u) / 16u;

    for (uint t = 0u; t < num_tiles; ++t) {
        uint a_col = t * 16u + lx;
        uint b_row = t * 16u + ly;

        tileA[ly][lx] = (row < pc.M && a_col < pc.K) ? A[row * pc.K + a_col] : 0.0;
        tileB[ly][lx] = (b_row < pc.K && col < pc.N) ? B[b_row * pc.N + col] : 0.0;

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += tileA[ly][k] * tileB[k][lx];
        }

        barrier();
    }

    if (row < pc.M && col < pc.N) {
        C[row * pc.N + col] = acc;
    }
}
