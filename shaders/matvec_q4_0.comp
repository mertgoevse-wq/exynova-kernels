#version 450
layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
} pc;

// Block-32 Q4_0 layout:
// Each 32-weight block is packed into 4 uint32 words (8 4-bit nibbles per uint32)
// plus 1 float scale. Each nibble u in [0..15] decodes to float(int(u) - 8) * scale.
layout(set = 0, binding = 0) readonly buffer BufWeightsQ4 { uint weights_q4[]; };
layout(set = 0, binding = 1) readonly buffer BufScales { float scales[]; };
layout(set = 0, binding = 2) readonly buffer BufX { float x_data[]; };
layout(set = 0, binding = 3) writeonly buffer BufY { float y_data[]; };

shared float sdata[64];

void main() {
    uint m = gl_WorkGroupID.x;
    if (m >= pc.M || pc.K == 0u) {
        return;
    }

    uint tid = gl_LocalInvocationID.x;
    uint words_per_row = pc.K >> 3u;
    uint blocks_per_row = pc.K >> 5u;
    uint weight_row_base = m * words_per_row;
    uint scale_row_base = m * blocks_per_row;

    float local_sum = 0.0;
    for (uint w = tid; w < words_per_row; w += 64u) {
        uint word = weights_q4[weight_row_base + w];
        uint k_base = w << 3u;
        float scale = scales[scale_row_base + (k_base >> 5u)];

        int q0 = int((word >>  0u) & 0xFu) - 8;
        int q1 = int((word >>  4u) & 0xFu) - 8;
        int q2 = int((word >>  8u) & 0xFu) - 8;
        int q3 = int((word >> 12u) & 0xFu) - 8;
        int q4 = int((word >> 16u) & 0xFu) - 8;
        int q5 = int((word >> 20u) & 0xFu) - 8;
        int q6 = int((word >> 24u) & 0xFu) - 8;
        int q7 = int((word >> 28u) & 0xFu) - 8;

        float dot8 = float(q0) * x_data[k_base + 0u] +
                     float(q1) * x_data[k_base + 1u] +
                     float(q2) * x_data[k_base + 2u] +
                     float(q3) * x_data[k_base + 3u] +
                     float(q4) * x_data[k_base + 4u] +
                     float(q5) * x_data[k_base + 5u] +
                     float(q6) * x_data[k_base + 6u] +
                     float(q7) * x_data[k_base + 7u];
        local_sum += scale * dot8;
    }

    sdata[tid] = local_sum;
    barrier();

    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) {
            sdata[tid] += sdata[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        y_data[m] = sdata[0];
    }
}
